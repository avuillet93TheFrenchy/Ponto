{
  "name": "ponto",
  "version": "1.0.0",
  "private": true,
  "description": "Multilingual translation app built with Tauri 2, using the DeepL and Lara engines.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:analyze": "cross-env ANALYZE=true vite build",
    "build:web": "vite build --mode web",
    "dev:web": "pnpm build:web && wrangler dev -c worker/wrangler.toml",
    "deploy:web": "cross-env NODE_ENV=production pnpm build:web && wrangler deploy -c worker/wrangler.toml",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "ts:versions": "tsc --version",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build --apk --target aarch64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lint": "pnpm run lint:js && pnpm run lint:css && pnpm run lint:html",
    "lint:js": "eslint src __tests__",
    "lint:css": "stylelint \"src/**/*.{css,scss,sass}\"",
    "lint:html": "htmlhint \"index.html\"",
    "lint:fix:js": "eslint src __tests__ --fix",
    "lint:fix:css": "stylelint \"src/**/*.{css,scss}\" --fix"
  },
  "keywords": [
    "windows",
    "android",
    "translation",
    "multilingual",
    "tauri",
    "deepl",
    "lara",
    "exe",
    "apk"
  ],
  "author": "Alexandre Vuillet (https://github.com/avuillet93TheFrenchy)",
  "license": "Apache-2.0",
  "homepage": "https://github.com/avuillet93TheFrenchy/Ponto#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avuillet93TheFrenchy/Ponto.git"
  },
  "bugs": {
    "url": "https://github.com/avuillet93TheFrenchy/Ponto/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.10.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.10.1",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@sentry/cli": "^3.8.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autoprefixer": "^10.6.1",
    "browserslist": "^4.29.3",
    "cross-env": "^10.1.0",
    "css-declaration-sorter": "^7.4.0",
    "cssnano": "^9.1.2",
    "dotenv": "^18.0.5",
    "eslint": "^10.11.0",
    "eslint-plugin-security": "^4.1.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "html-minifier-terser": "^7.2.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "rolldown": "^1.2.12",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@sentry/browser": "^11.1.0",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "@tauri-apps/plugin-window-state": "^2.5.0",
    "tauri-plugin-sentry-api": "^0.5.0"
  }
}
